# "codex" (default) permits browser submission. "viewer" is for Codex chat and replay.
COUNCIL_RUNNER=codex
PORT=4730
CODEX_MODEL=gpt-6.2-sol
# Optional native executable path, for a Windows installation outside PATH.
CODEX_BIN=
# Optional local API Anything CLI JavaScript entry point and yt-dlp executable.
ROAST_API_ANYTHING_CLI=
ROAST_YT_DLP=
