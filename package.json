{
  "name": "roast-room-codex",
  "version": "2.0.0",
  "private": true,
  "description": "A local Codex decision council with evidence, weighted scoring and replay.",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "room": "node app/roast-room.mjs",
    "demo": "node app/roast-room.mjs demo",
