    "test": "node --test app/test/*.test.mjs",
    "lint": "eslint app --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
